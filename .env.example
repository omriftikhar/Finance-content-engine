# ─────────────────────────────────────────────────────────────
# Finance Content Engine — environment
# The app runs fully in MOCK mode with NONE of these set.
# ─────────────────────────────────────────────────────────────

# Runtime routing ------------------------------------------------
# TEXT_PROVIDER: mock | deepseek | minimax  (mock = no API keys needed)
TEXT_PROVIDER=mock
# TTS_PROVIDER: mock | minimax
TTS_PROVIDER=mock
# STORE_DRIVER: file | supabase
STORE_DRIVER=file

# Cost governor --------------------------------------------------
MAX_VIDEO_BUDGET_USD=3

# Text providers (server-only; never exposed to client) ----------
# DeepSeek (primary cheap tier)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# MiniMax (secondary cheap tier + TTS)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=minimax-text-01
MINIMAX_TTS_MODEL=speech-2.5-hd-preview
MINIMAX_TTS_VOICE=English_expressive_narrator
MINIMAX_TTS_COST_PER_1K=0.10

# Premium fallback (OpenAI-compatible)
PREMIUM_API_KEY=
PREMIUM_BASE_URL=https://api.openai.com/v1
PREMIUM_MODEL=gpt-4o
# OPENAI_API_KEY is accepted as an alias for PREMIUM_API_KEY
OPENAI_API_KEY=

# Supabase (only when STORE_DRIVER=supabase) ---------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (only used by the render worker) -----------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
